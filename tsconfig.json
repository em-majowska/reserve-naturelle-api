{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "bundler",
    "types": ["node", "jest"],

    // Recommended Options
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*", "prisma7.config.ts", "prisma/seed.ts", "tests/**/*"],
  "exclude": ["node_modules"]
}
